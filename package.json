{
  "name": "@vibeclasses/docs-to-code",
  "version": "0.0.1",
  "description": "Complete toolkit for managing Agile documentation with JSON schemas, validation, and bidirectional conversion",
  "main": "src/index.ts",
  "type": "module",
  "public": true,
  "private": false,
  "bin": {
    "docs-to-code": "bin/docs-to-code"
  },
  "scripts": {
    "start": "node --import tsx src/cli.ts",
    "dev": "node --watch src/cli.ts --import tsx",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "validate": "node --import tsx src/cli.ts validate",
    "init": "node --import tsx src/cli.ts init",
    "convert": "node --import tsx src/cli.ts convert",
    "build-docs": "node --import tsx src/cli.ts build"
  },
  "keywords": [
    "agile",
    "documentation",
    "user-stories",
    "acceptance-criteria",
    "functional-requirements",
    "json-schema",
    "markdown",
    "validation",
    "typescript"
  ],
  "author": "Marco Antonio Gonzalez Junior <m@rco.sh>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "glob": "^10.3.10",
    "handlebars": "^4.7.8",
    "inquirer": "^9.2.12",
    "js-yaml": "^4.1.0",
    "marked": "^9.1.6",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/handlebars": "^4.1.0",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.8.3"
  },
  "files": [
    "src/**/*",
    "templates/**/*",
    "bin/**/*",
    "README.md"
  ]
}
